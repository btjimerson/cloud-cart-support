# Model provider
# Agents get their model from a Model artifact in the catalog, not from this file.
# This key is what the gateway presents upstream on their behalf.
OPENAI_API_KEY=

# Solo Enterprise license keys
ENTERPRISE_AGENTGATEWAY_LICENSE_KEY=
ENTERPRISE_KGATEWAY_LICENSE_KEY=
ENTERPRISE_KAGENT_LICENSE_KEY=
ENTERPRISE_AGENTREGISTRY_LICENSE_KEY=

# Solo Enterprise versions -- pinned to what is installed on the target cluster
ENTERPRISE_AGENTGATEWAY_VERSION=v2026.8.0
ENTERPRISE_KAGENT_VERSION=0.5.4
ENTERPRISE_AGENTREGISTRY_VERSION=v2026.7.1

# Gateway API CRDs
GATEWAY_API_VERSION=v1.4.0

# agentregistry
AGENTREGISTRY_URL=http://agentregistry-enterprise-server.agentregistry-system.svc:12121
AGENTREGISTRY_RUNTIME=kagent
CONCIERGE_AGENT=support-concierge

# Kubernetes
NAMESPACE=agentic-demo
